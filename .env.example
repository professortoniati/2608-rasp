# Rasp Automação - Environment Variables Example
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA comite o arquivo .env real no GitHub

# Configurações do Formulário de Contato
# Para integração com serviços como Formspree, Netlify Forms, ou API própria
CONTACT_FORM_ENDPOINT=https://api.seuservico.com/contact
CONTACT_FORM_API_KEY=sua_api_key_aqui

# Configurações de Analytics (opcional)
GA_MEASUREMENT_ID=G-XXXXXXXXXX
GTM_CONTAINER_ID=GTM-XXXXXXX

# Configurações de WhatsApp Business API (opcional)
WHATSAPP_PHONE_NUMBER=5511963987438
WHATSAPP_API_TOKEN=seu_token_whatsapp_aqui

# Configurações de E-mail (para backend próprio)
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_USER=seu_email@dominio.com
SMTP_PASS=sua_senha_smtp
SMTP_FROM=contato@raspautomacao.com.br